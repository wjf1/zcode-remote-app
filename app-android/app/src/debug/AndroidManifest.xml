<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建合并进来（release 变体的 merged manifest 不含本文件任何组件）。
  DebugApprovalReceiver 用来在没有真实审批时注入假的 pending，
  验证通知渲染 / 按钮回调 / 断线时的"没发出去"提示。

  安全收紧（任务书 §11.3.2）：
  - 两个 receiver 仍为 exported=true（adb shell uid 无法广播给 exported=false 的组件），
    但 onReceive 里强制校验「严格 action + 一次性令牌（DebugInjectionGuard）」，无令牌一律拒绝。
  - 明文流量只在 debug 放开（Release 由 src/main 的 usesCleartextTraffic=false 兜底），
    供局域网 ws:// 中继调试；Release 不得出现本覆盖。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <receiver
            android:name=".debug.DebugApprovalReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.zcode.remote.action.DEBUG_APPROVAL" />
                <action android:name="com.zcode.remote.action.DEBUG_APPROVAL_CLEAR" />
            </intent-filter>
        </receiver>

        <!-- 真机验收用：注入配对凭据，跳过扫码/粘贴（input text 会被 IME 打乱） -->
        <receiver
            android:name=".debug.DebugPairReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.zcode.remote.action.DEBUG_PAIR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
