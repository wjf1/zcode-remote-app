<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- B 组网络感知重连：NetworkGate 的 registerDefaultNetworkCallback / activeNetwork 查询必需 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- P0-A：连接保活改用 specialUse 型前台服务（dataSync 在 Android 15 有 24h 内 6h 硬超时） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 语音输入（P1-3）：SpeechRecognizer 运行时权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility：解析系统的 RecognitionService（小米为小爱语音引擎） -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="ZCode Remote"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.ZCodeRemote"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <!-- P0 传输止血（任务书 §11.3.1）：Release 关闭一切明文流量，中继连接强制 wss://。
             本项目 minSdk 31、无 networkSecurityConfig，故该属性即为最低明文策略；
             无任何本地回环（127.0.0.1/localhost）依赖，关闭明文不误伤既有能力。
             debug 变体在 src/debug/AndroidManifest.xml 单独放开（仅用于局域网 ws:// 调试）。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sprint 5：系统级 Share Sheet 分享接入（文本与文件附件） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Sprint 5：配对链接 VIEW Deep Link（支持 zcode://pair 与官方 https 链接一键唤起自动配对） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zcode" android:host="pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zcode.z.ai" android:pathPrefix="/remote" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zcode.chatglm.site" android:pathPrefix="/remote" />
            </intent-filter>
        </activity>

        <!-- P0-A：中继连接保活前台服务（specialUse 不受 Android 15 dataSync 6h/24h 超时限制） -->
        <service
            android:name=".service.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持与 ZCode 桌面端的中继长连接以接收实时审批通知" />
        </service>

        <!-- 审批通知栏按钮的回调（批准/拒绝），必须 exported=false，只收自己发的广播 -->
        <receiver
            android:name=".notify.ApprovalReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zcode.remote.action.RESOLVE_APPROVAL" />
            </intent-filter>
        </receiver>

        <!-- 表单交互（elicitation）通知栏快捷应答与 RemoteInput 内联输入的回调，同样 exported=false -->
        <receiver
            android:name=".notify.ElicitationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zcode.remote.action.RESOLVE_ELICITATION" />
                <action android:name="com.zcode.remote.action.REPLY_ELICITATION_TEXT" />
            </intent-filter>
        </receiver>

        <!-- 桌面 Widget（P2-3）：待处理角标，App 内主动推送更新 -->
        <receiver
            android:name=".widget.PendingWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pending_info" />
        </receiver>
    </application>
</manifest>
