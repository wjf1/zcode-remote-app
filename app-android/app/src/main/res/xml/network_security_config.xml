<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全策略（P1-7：把此前只写在 Manifest 属性 + 代码注释里的明文策略，固化为
  显式、可审计的单一事实来源）。

  策略（release / 主源集）：
  - 全应用禁止明文流量（cleartextTrafficPermitted="false"）；
  - 信任锚仅系统 CA（默认即如此——targetSdk ≥ 24 起不自动信任用户安装的 CA；
    这里显式写出，避免未来有人误加 <certificates src="user"/> 而静默放宽）。

  ⚠️ 为什么不在这里做证书固定（CertificatePinner / <pin-set>）：
  - 中继 `zcode.z.ai` 使用 **`*.z.ai` 通配符证书**（Sectigo DV 签发，2026-11-27 到期，
    每年轮换）；硬钉叶证书或中间 CA，官方一旦轮换/更换 CA，本 App 将**彻底无法连接**
    （含配对），而本项目为侧载分发、**没有自动更新渠道**，用户只能等新 APK。
  - 具备稳定性的替代（钉根 CA）同样受「官方可能更换 CA」影响，且根证书被大量站点共用，
    对 MITM 的边际防护有限。
  - 综合判定：**不以可用性换取此处有限的防护增益**。既有防线（release 强制 wss://、
    明文关闭、HMAC 握手 proof、日志脱敏）保持不变。
  - 若后续官方提供明确的证书轮换承诺或固定 CA，可在此文件的 <domain-config> 中补 <pin-set>
    （OkHttp/平台支持同域多 pin，任一匹配即通过，便于灰度切换）。

  debug 变体另有 src/debug/res/xml/network_security_config.xml（放开局域网 ws:// 调试），
  资源同名覆盖本文件——见该文件说明。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
