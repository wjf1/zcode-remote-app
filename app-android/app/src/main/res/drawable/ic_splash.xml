<?xml version="1.0" encoding="utf-8"?>
<!--
  原生启动屏图标（API 31+ windowSplashScreenAnimatedIcon）。

  官方尺寸规范：画布 288x288dp，图形本体取内圈 2/3（192x192dp），
  系统会按设备蒙版裁切——按官方比例摆放可避免图形被裁或显得过大。
  直接复用 48dp 的 ic_launcher_foreground 会因尺寸不达标触发 lint 告警。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <!-- 48 单位画布 -> 192 单位内圈：缩放 4x，居中偏移 (288-192)/2 = 48 -->
    <group
        android:scaleX="4"
        android:scaleY="4"
        android:translateX="48"
        android:translateY="48">
        <path
            android:fillColor="#7C9EFF"
            android:pathData="M10,8h28a4,4 0 0 1 4,4v20a4,4 0 0 1 -4,4h-10l4,6h-16l4,-6h-10a4,4 0 0 1 -4,-4v-20a4,4 0 0 1 4,-4z" />
        <path
            android:fillColor="#161616"
            android:pathData="M12,13h24v2h-24z M12,18h18v2h-18z M12,23h22v2h-22z" />
    </group>
</vector>
