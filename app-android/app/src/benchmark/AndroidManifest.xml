<?xml version="1.0" encoding="utf-8"?>
<!--
  Macrobenchmark 源集清单（仅合并进 `benchmark` 构建变体，不进 debug/release 包）。
  benchmark 变体不出现在任何发布通道：release 断言（明文关停 / 无 debug 组件 / 不可调试）
  只对 app-release-*.apk 生效，与本清单无关。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- macrobenchmark 硬要求：被测进程必须 profileable（否则库拒绝对该包测量）。 -->
        <profileable android:shell="true" />

        <!-- exported=true：benchmark 框架以 shell uid 经 `am start -W <intent-uri>` 拉起本页。 -->
        <activity
            android:name=".bench.BenchmarkConversationActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:theme="@style/Theme.ZCodeRemote" />
    </application>
</manifest>
